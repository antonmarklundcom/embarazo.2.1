# --- MINIMUM VIABLE (launch with these) ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BUSINESS_WHATSAPP=          # +595... fallback contact
NEXT_PUBLIC_MEDICAL_REVIEWER=           # e.g. "Dra. ___, gineco-obstetra"

# --- ACCOUNTS & SYNC (Phase A) ---
# The app must still build and run with ALL of these unset — that is
# "seguir sin cuenta" / local-only mode. See ARCHITECTURE.md §4.
DATABASE_URL=                            # mysql://user:pass@host:3306/dbname
                                         # Unset = local-only mode (the app
                                         # runs fully; accounts/sync are off).
                                         # Apply schema: npm run db:migrate
AUTH_SECRET=                             # openssl rand -base64 32
AUTH_URL=                                # https://... (prod only)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ENABLED=false              # needs Meta business verification first
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# --- ADMIN PANEL (A7 / Phase I) ---
ADMIN_EMAILS=                            # comma-separated; seeds users.role = admin

# --- PUSH NOTIFICATIONS (Phase B5) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=                           # mailto:... or https://...

# --- AI BABY IMAGE (Phase F) — has a per-image cash cost ---
# Both limits below are enforced server-side on every request (F2) and both
# fail CLOSED: unset or malformed falls back to the conservative default, never
# to "unlimited". Either can be cut without a deploy.
AI_BABY_ENABLED=false                    # global kill switch; only "true" enables
GEMINI_API_KEY=
AI_BABY_MONTHLY_QUOTA=3                  # per user, per UTC month. 0 = off for
                                         # everyone. Empty = the default (3).
AI_BABY_MONTHLY_SPEND_CEILING_USD=50     # hard stop across all users, per month.
                                         # Empty = the default ($50). ≈$0.04 an
                                         # image, so $50 ≈ 1 250 images.
AI_BABY_MODEL=                           # empty = gemini-2.5-flash-image
AI_BABY_COST_MICROS=                     # per image, USD micros; empty = 40000
                                         # (≈$0.04, the ≤1024px tier). Verify
                                         # against Google's price page — it moves.

# --- OPTIONAL (app must run fully without these) ---
SHEETS_WEBHOOK_URL=                      # optional click attribution; unset = plain redirect
WP_API_URL=                              # optional future content source; unset = in-repo seed
