    "@tanstack/react-query": "^5.59.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.23.1",
    "next": "^15.5.23",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.24.1"
